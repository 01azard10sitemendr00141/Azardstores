# Copy to backend/.env and fill in the values required for your deployment.
MONGO_URI=mongodb://localhost:27017/azardstores
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Local development default. Production must use the exact public HTTPS storefront origin, no trailing slash.
CLIENT_URL=http://localhost:5173
PORT=5000
# Set to the exact number of trusted reverse-proxy hops in front of this API.
# Leave unset when clients connect directly; do not guess this value.
TRUST_PROXY_HOPS=

# Email delivery. Email features log or remain unavailable until configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
CONTACT_EMAIL=

# Paystack payments (optional)
PAYSTACK_SECRET_KEY=
PAYSTACK_MPESA_ENABLED=false

# WhatsApp webhook (optional)
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Africa's Talking SMS (optional)
AT_API_KEY=
AT_ENV=sandbox
AT_USERNAME=
AT_SENDER_ID=

# Optional first admin for the seed script
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
